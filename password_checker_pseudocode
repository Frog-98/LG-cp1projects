GET user password

LOOP
IF user password has at least 8 characters AND less than 20 characters
8 characters score = 1
BREAK
ELSE
8 characters score = 0
BREAK

LOOP
IF user password has uppercase letter
Upper  case score = 1
BREAK
ELSE
Upper case score = 0
BREAK

LOOP
IF user password has number
Number score = 1
BREAK
ELSE
Number score = 0 
BREAK

IF password score = 3
	DISPLAY
“Password strength = 3, Strong Password”

IF password score = 2
	DISPLAY
“Password strength = 2, Decent Password: Upper case 1, 8 Characters 0, Number 1”

IF password score = 1
	Display
“Password strength = 1, Bad Password: Upper case 0, 8 Characters 0, Number 1”

IF password score = 0
	DISPLAY
“Password Strength = 0, Awful Password, Upper case 0, 8 Characters 0, Number 0”
